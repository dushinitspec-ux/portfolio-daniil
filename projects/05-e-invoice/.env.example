# --- Mode -----------------------------------------------------------------
# true = offline rule-based extractor only, sample PDFs one click away, no API key needed.
DEMO_MODE=true
# auto   = Claude when ANTHROPIC_API_KEY is set (and DEMO_MODE is false), otherwise rules
# rules  = always the offline extractor (works on layouts like the bundled samples)
# claude = always Claude (fails without a key)
EXTRACTOR=auto

# --- Claude (Anthropic API) -----------------------------------------------
# Leave empty to use the offline extractor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# --- Storage and web ------------------------------------------------------
DATABASE_PATH=data/invoices.db
SAMPLES_DIR=samples
MAX_UPLOAD_MB=10
MAX_PAGES=20
HOST=127.0.0.1
PORT=8105

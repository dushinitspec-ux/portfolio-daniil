# --- Mode -----------------------------------------------------------------
# true = a sample menu of 16 dishes for a made-up restaurant, stored in data/demo.db.
# Same as `uv run python -m app --demo`.
DEMO_MODE=true

# --- AI suggestions (optional) --------------------------------------------
# Without a key, unknown or ambiguous ingredients are simply flagged for the chef.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max - more effort is slower and costs more.
ANTHROPIC_EFFORT=medium
# false = never call the AI, even when a key is set.
AI_SUGGESTIONS=true

# --- Menu and storage -----------------------------------------------------
# Printed at the top of the menu. Empty = "Sample Kitchen" in demo mode, "Our menu" otherwise.
RESTAURANT_NAME=
# Empty = data/demo.db in demo mode, data/allergens.db otherwise.
DATABASE_PATH=
# Time zone for confirmation times on the pages and the menu.
TIMEZONE=Europe/Istanbul
HOST=0.0.0.0
PORT=8110

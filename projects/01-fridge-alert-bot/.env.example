# --- Telegram -------------------------------------------------------------
# Leave BOT_TOKEN empty for demo mode: alerts are printed to the console.
BOT_TOKEN=
# Chat that receives alerts. Send /id to the bot to find it (group ids start with -100).
ALERT_CHAT_ID=
# Extra chats allowed to use the commands, comma-separated.
ALLOWED_CHAT_IDS=

# --- HTTP API -------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Sensors send this in the X-API-Key header.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEY=change-me

DATABASE_PATH=data/fridge.db

# --- Alert rules ----------------------------------------------------------
DEFAULT_LIMIT_C=5.0
# Alert when a fridge stays above its limit at least this long.
ALERT_DELAY_MINUTES=5
# "Back to normal" only when it is this much below the limit (stops flapping).
RECOVERY_HYSTERESIS_C=0.5
# Do not send alerts about events older than this (late uploads, backfill).
ALERT_MAX_AGE_MINUTES=15
# /status marks a sensor grey when it has been silent this long.
STALE_AFTER_MINUTES=10

# --- Reports --------------------------------------------------------------
TIMEZONE=Europe/Istanbul
# Daily summary time (local). Empty disables it.
DAILY_REPORT_TIME=09:00

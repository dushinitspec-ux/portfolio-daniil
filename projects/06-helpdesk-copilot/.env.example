# --- Mode -----------------------------------------------------------------
# true = offline demo: extractive answers, rule-based triage, sample tickets, no API key.
# DEMO=1 works too.
DEMO_MODE=true

# --- Claude (needed when DEMO_MODE=false) ---------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max - more effort is slower and costs more.
ANTHROPIC_EFFORT=medium
# Triage is a short classification; low effort is enough.
ANTHROPIC_TRIAGE_EFFORT=low

# --- Telegram -------------------------------------------------------------
# Token from @BotFather. Empty = only the web page runs.
BOT_TOKEN=
# Chat that receives every new ticket: the IT person's own chat or an IT group.
# Send /id to the bot there and paste the number (group ids start with -100).
IT_CHAT_ID=

# --- Knowledge base and retrieval -----------------------------------------
COMPANY_NAME=Sample Office
KNOWLEDGE_DIR=knowledge
# Sections given to the model as numbered sources.
TOP_K=4
# A question goes to a ticket without an LLM call when the best section covers less than
# this share of it (0..1). 0.3 is what the evaluation was run with (README, "Evaluation").
MIN_COVERAGE=0.3
MIN_SCORE=2.0

# --- Storage and web page -------------------------------------------------
DATABASE_PATH=data/helpdesk.db
HOST=0.0.0.0
PORT=8106
TIMEZONE=Europe/Berlin

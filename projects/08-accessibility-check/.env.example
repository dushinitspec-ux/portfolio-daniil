# --- Mode -----------------------------------------------------------------
# true = the bundled "Sample Shop" (broken and fixed) is scanned at start-up and the
# shop-owner summary always uses the fixed offline texts. DEMO=1 works too.
DEMO_MODE=true

# --- Crawler --------------------------------------------------------------
# Pages per scan (requests, not counting robots.txt). The web form can lower or raise it, up to 200.
MAX_PAGES=20
# Parallel requests to the scanned site, and the pause after each request (seconds).
# A Crawl-delay in robots.txt overrides both: one request at a time, with that pause.
CONCURRENCY=2
REQUEST_DELAY_S=0.5
REQUEST_TIMEOUT_S=15
# Larger HTML pages are recorded but not analysed.
MAX_PAGE_BYTES=3000000
# robots.txt groups are matched against the first word, "AccessibilityCheckBot".
USER_AGENT=AccessibilityCheckBot/0.1.0 (static WCAG check; obeys robots.txt)
# false = refuse URLs on private, loopback or link-local addresses (192.168.x.x, 127.0.0.1,
# cloud metadata 169.254.169.254). Set to true only to scan sites in your own network.
ALLOW_PRIVATE_TARGETS=false
# Scans running at the same time; more requests wait.
MAX_PARALLEL_SCANS=2

# --- Plain-language summary for a shop owner --------------------------------
# fixed = hand-written texts per rule, offline. anthropic = Claude writes the summary
# (in English, German, Russian or Turkish). Demo mode always uses the fixed texts.
AI_PROVIDER=fixed
# Leave empty to use ANTHROPIC_API_KEY from the environment or an `ant auth login` profile.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# --- Storage and web UI -----------------------------------------------------
DATABASE_PATH=data/reports.db
# 127.0.0.1 = only this computer. docker-compose.yml sets 0.0.0.0 inside the container.
HOST=127.0.0.1
PORT=8108

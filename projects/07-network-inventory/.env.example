# --- Mode -----------------------------------------------------------------
# true = a simulated office network with two scans, kept in memory. No scanning at all.
# (DEMO=1 works too.)
DEMO_MODE=true

# --- What to scan ---------------------------------------------------------
# Scan ONLY networks you own or have written permission to scan.
# Comma-separated IPv4 networks, e.g. 192.168.1.0/24,10.0.20.0/24. Required outside demo.
SCAN_CIDRS=
# Private ranges (RFC 1918) and loopback only. Set to true only for public ranges you own.
ALLOW_PUBLIC=false
# Networks larger than this prefix are refused: 22 = /22 = 1022 hosts.
SUBNET_LIMIT=22
# TCP ports to probe on every device that answered. Keep the list short.
SCAN_PORTS=21,22,23,80,139,443,445,554,3389,5900,8080,8291,8443,9100
# Minutes between scans. 0 = only when you press "Scan now" (or POST /api/scan).
SCAN_INTERVAL_MIN=60

# --- Probing --------------------------------------------------------------
PING_TIMEOUT_S=1
# Only "open" matters here, so 1 s is enough on a LAN.
TCP_TIMEOUT_S=1
DNS_TIMEOUT_S=2
REVERSE_DNS=true
MAX_PARALLEL_PINGS=64
MAX_PARALLEL_CONNECTS=128

# --- Telegram -------------------------------------------------------------
# Leave empty to print alerts in the console.
BOT_TOKEN=
# Chat that receives alerts (group ids start with -100).
ALERT_CHAT_ID=

# --- Storage and web page -------------------------------------------------
DATABASE_PATH=data/inventory.db
# The page has no login and lists your weak spots: keep it on localhost, or put it
# behind a reverse proxy with authentication before using 0.0.0.0.
HOST=127.0.0.1
PORT=8107
TIMEZONE=Europe/Istanbul

# --- Mode -----------------------------------------------------------------
# true = answers come from an offline, deterministic demo model: no API key needed,
# nothing leaves your machine. false = masked prompts go to Claude.
DEMO_MODE=true

# --- Claude (used when DEMO_MODE=false) -------------------------------------
# Only masked text is ever sent. Leave empty to use the SDK's other credential sources.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max - more effort is slower and costs more.
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=16000

# --- Detection and policy -------------------------------------------------
# mask / block / allow per entity type.
POLICY_FILE=policy.yaml
# Known names, one per line (e.g. exported from your CRM). Empty = names.demo.txt in
# demo mode, no name detection otherwise.
NAMES_FILE=
# Regions whose national phone formats are recognised (030 12345678 for DE).
# International numbers (+49..., 0049...) are found whatever this is set to.
PHONE_REGIONS=DE

# --- Storage and web ------------------------------------------------------
# Audit log: timestamps, entity types, counts and decisions. Never values.
DATABASE_PATH=data/audit.db
# Longest accepted request, in characters.
MAX_INPUT_CHARS=20000
# 127.0.0.1 = only this machine. docker-compose.yml sets 0.0.0.0 inside the container.
HOST=127.0.0.1
PORT=8104

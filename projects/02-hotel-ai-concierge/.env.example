# --- Telegram -------------------------------------------------------------
# Token from @BotFather. Not needed for the terminal demo (uv run python -m app.demo).
BOT_TOKEN=
# Staff group that receives questions the bot cannot answer.
# Add the bot to the group, send /id there, paste the number (group ids start with -100).
STAFF_CHAT_ID=
# Telegram user ids allowed to use /reload and /stats, comma-separated.
ADMIN_IDS=

# --- LLM ------------------------------------------------------------------
# mock = offline demo without an API key; anthropic or openai for real answers.
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max - more effort is slower and costs more.
ANTHROPIC_EFFORT=medium

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Behaviour ------------------------------------------------------------
HOTEL_NAME=Lara Breeze Hotel
KNOWLEDGE_PATH=knowledge/hotel.md
DATABASE_PATH=data/concierge.db
# How many previous messages the LLM sees for context.
HISTORY_MESSAGES=6
# Max messages per guest per minute (each one is a paid LLM call).
RATE_LIMIT_PER_MINUTE=10
# Translate staff replies into the guest's language.
TRANSLATE_STAFF_REPLIES=true

# --- Mode -----------------------------------------------------------------
# true = bundled real prices (DE-LU, 20 Sep - 25 Oct 2026), offline, clock fixed at the
# moment they were downloaded. Same as running with --demo.
DEMO_MODE=true
# Devices and the power cap.
DEVICES_FILE=devices.yaml

# --- Market ---------------------------------------------------------------
# Bidding zone as Energy-Charts names it: DE-LU, AT, BE, CH, CZ, DK1, DK2, FR, NL, PL...
# Only some zones are CC BY 4.0 (see README, "Data and licence").
BIDDING_ZONE=DE-LU
# Plans and messages use this local time. Use the zone's own time zone.
TIMEZONE=Europe/Berlin
# energy-charts (no token) or entsoe (needs ENTSOE_TOKEN).
PRICE_SOURCE=energy-charts
ENERGY_CHARTS_URL=https://api.energy-charts.info
# Free token from the ENTSO-E Transparency Platform (account -> Web API access).
ENTSOE_TOKEN=

# --- Telegram -------------------------------------------------------------
# Leave empty to print the daily plan in the console.
BOT_TOKEN=
# Chat that receives the plan (group ids start with -100). The bot's /id command shows it.
PLAN_CHAT_ID=
# The day-ahead auction closes at 12:00 CET and results come out shortly before 13:00.
# Send tomorrow's plan at this local time; if the prices are late, retry until
# SEND_RETRY_UNTIL, then send a warning.
SEND_AT=14:00
SEND_RETRY_UNTIL=20:00

# --- Shelly plugs ---------------------------------------------------------
# true = only log the request that would be sent. Set false to really switch plugs.
SHELLY_DRY_RUN=true

# --- Storage and web page -------------------------------------------------
DATABASE_PATH=data/energy.db
HOST=127.0.0.1
PORT=8109
